{
  "name": "sky-island-post-dispatcher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "浮空岛邮政调度员：React 调度面板 + Node.js 权威游戏服务",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/tests/*.test.js sandbox/tests/*.test.js",
    "test:sandbox": "node --test sandbox/tests/*.test.js",
    "sandbox": "node sandbox/cli.js",
    "check": "npm test && npm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "vite": "^7.1.7"
  }
}
